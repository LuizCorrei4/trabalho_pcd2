# Ambientes virtuais
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --------------------------------------------------------------------------- #
# Dados (reproduzíveis via python -m src.coleta.runner --all)                  #
# --------------------------------------------------------------------------- #
# Dados brutos, intermediários e descartados são pesados e não devem ser versionados.
# Os coletores e o orquestrador recriam toda a estrutura automaticamente.

# Arquivos de dados pesados e binários
*.parquet
*.zip
*.tar.gz
*.7z
*.tsv
*.xlsx
*.json
*.txt
*.csv
!data/processed/dim_uf.csv

# Estrutura de pastas de dados (ignora conteúdo, preserva .gitkeep e .md)
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/**/*.md

data/interim/**
!data/interim/
!data/interim/**/
!data/interim/**/.gitkeep
!data/interim/**/*.md

data/processed/**
!data/processed/
!data/processed/**/
!data/processed/**/.gitkeep
!data/processed/dim_uf.csv

data/Dados_descartados/

# Logs transacionais locais e chunks
*_download_log.csv
data/raw/sidra_ipca/chunks/

# --------------------------------------------------------------------------- #
# Python & Bytecode                                                           #
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Modelos treinados (pesados)
models/*
!models/.gitkeep

# Arquivos temporários e scratch
temp/
*.tmp
*.bak
*.part

# --------------------------------------------------------------------------- #
# Logs de Execução e Backups (efêmeros, não versionar no Git)                 #
# --------------------------------------------------------------------------- #
logs/*
!logs/.gitkeep
!logs/README.md